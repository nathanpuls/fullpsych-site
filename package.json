{
  "name": "fullpsych-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tinacms dev -p 4003 --datalayer-port 9003 -c \"astro dev --host 127.0.0.1 --port 4323\"",
    "build": "tinacms build --local --skip-cloud-checks -p 4004 --datalayer-port 9004 -c \"node scripts/build-site.mjs\"",
    "preview": "astro preview --host 127.0.0.1 --port 4323",
    "predev": "node scripts/generate-brand-icons.mjs",
    "prebuild": "node scripts/generate-brand-icons.mjs"
  },
  "dependencies": {
    "astro": "6.4.8",
    "@astrojs/node": "10.1.4",
    "@tinacms/astro": "0.8.0",
    "tinacms": "3.15.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "gray-matter": "4.0.3",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@tinacms/cli": "4.0.5",
    "typescript": "6.0.3"
  }
}
