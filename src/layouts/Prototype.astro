---
import design from '../../prototype/settings/design.json';
import '../../prototype/site.css';
const {title,description,page} = Astro.props;
---
<!doctype html>
<html lang="en" data-accent={design.accent} data-width={design.width}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title} · FullPsych prototype</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="prototype-banner">FullPsych prototype <span>Private working preview · production is unchanged</span></div>
  <header class="site-header">
    <a class="brand" href="/"><img src="/assets/logo.png" alt="" /><span>FullPsych</span></a>
    <nav aria-label="Main navigation">
      <a href="/" aria-current={page === 'home' ? 'page' : undefined}>Home</a>
      <a href="/about/" aria-current={page === 'about' ? 'page' : undefined}>About</a>
      {import.meta.env.DEV && <a class="edit-link" href={page === 'about' ? '/keystatic/singleton/about' : '/keystatic/singleton/home'}>Edit page ↗</a>}
    </nav>
  </header>
  <main class:list={['page', { 'with-portrait': page === 'about' }]}>
    <article><p class="eyebrow">CARE THAT STARTS WITH LISTENING</p><slot /></article>
    {page === 'about' && <aside><img class="portrait" src="/assets/nathan-puls.png" alt="Nathan Puls" /></aside>}
  </main>
  <footer><strong>FullPsych</strong><span>English & Spanish · Telehealth</span>{import.meta.env.DEV && <a href="/keystatic">Open CMS ↗</a>}</footer>
</body>
</html>
