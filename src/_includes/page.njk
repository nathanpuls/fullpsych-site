---
layout: base.njk
---
{% if template == "home" %}
  <section class="home-hero"><div class="home-hero__copy prose">{{ content | safe }}</div></section>
{% elif template == "profile" %}
  <section class="profile-page page-width"><div class="profile-grid"><article class="prose">{{ content | safe }}</article><figure class="profile-photo"><img src="{{ image or site.portrait }}" alt="Portrait of {{ site.practitioner }}"></figure></div></section>
{% elif template == "approach" %}
  <section class="approach-page page-width prose">{{ content | safe }}</section>
{% elif template == "contact" %}
  <section class="contact-page page-width"><div class="contact-intro prose">{{ content | safe }}</div><form class="contact-form" action="https://api.web3forms.com/submit" method="post"><input type="hidden" name="access_key" value="{{ site.web3formsKey }}"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required><label for="message">Message</label><textarea id="message" name="message" rows="7" required></textarea><button type="submit">Send message</button></form></section>
{% elif template == "articles-index" %}
  <section class="articles-index page-width"><div class="prose">{{ content | safe }}</div><div class="article-list">{% for article in collections.publishedArticles %}<article><p class="eyebrow">{{ article.data.date | readableDate }}</p><h2><a href="{{ article.url }}">{{ article.data.title }}</a></h2>{% if article.data.description %}<p>{{ article.data.description }}</p>{% endif %}</article>{% else %}<p class="empty-state">Articles will appear here when they are published.</p>{% endfor %}</div></section>
{% else %}
  <article class="standard-page page-width prose">{{ content | safe }}</article>
{% endif %}
