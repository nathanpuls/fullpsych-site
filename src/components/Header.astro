---
import { tinaField } from '@tinacms/astro';
const { settings, pathname = Astro.url.pathname } = Astro.props;
---
<header class="site-header" id="site-header">
  <a class="brand" href="/"><img src={settings.logo} alt="" /><span data-tina-field={tinaField(settings, 'name')}>{settings.name}</span></a>
  <button class="mobile-menu-toggle" type="button" aria-controls="main-navigation" aria-expanded="false" aria-label="Toggle navigation">☰</button>
  <nav id="main-navigation" aria-label="Main navigation" data-tina-field={tinaField(settings, 'navigation')}>
    {settings.navigation?.map((item: any) => item && item.visible !== false && <a href={item.url} aria-current={item.url === pathname ? 'page' : undefined} data-tina-field={tinaField(item, 'label')}>{item.label}</a>)}
  </nav>
</header>
<script is:inline src="/assets/navigation.js"></script>
